#!/usr/bin/env python3
"""Run the repository's doctor procedure in one fresh Codex session."""

import argparse
from pathlib import Path
import subprocess
import sys

parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
commands = parser.add_subparsers(dest="command", required=True)
doctor = commands.add_parser(
    "doctor",
    help="inspect delivery evidence and propose a documentation patch",
    allow_abbrev=False,
)
doctor.add_argument(
    "--check", action="store_true", help="inspect and report without writing files"
)
release = commands.add_parser("release", help="prepare or inspect a release", allow_abbrev=False)
operations = release.add_subparsers(dest="operation", required=True)
prepare = operations.add_parser("prepare", allow_abbrev=False)
prepare.add_argument("--version", required=True)
prepare.add_argument("--ref", default="main")
prepare.add_argument("--resume")
status = operations.add_parser("status", allow_abbrev=False)
status.add_argument("--run", required=True)
args = parser.parse_args()

if args.command == "release":
    from release import delivery

    try:
        sys.exit(delivery(args))
    except (ValueError, OSError, KeyError, TypeError) as error:
        print(f"Release command failed: {error}", file=sys.stderr)
        sys.exit(1)

root = Path(__file__).resolve().parents[1]
prompt_path = root / "docs/agentic-software-delivery-v1.0/DOCTOR-PROMPT.md"
try:
    procedure = prompt_path.read_text(encoding="utf-8")
except (OSError, UnicodeError) as error:
    print(f"Cannot read doctor prompt {prompt_path}: {error}", file=sys.stderr)
    sys.exit(1)

mode = (
    "Run doctor --check: inspection only. Report findings without writing files."
    if args.check
    else "Run default doctor: inspect actual evidence, make an evidenced documentation patch "
    "on a docs branch when warranted, and wait for owner approval before commit, push, or merge."
)
request = (
    "Use .agents/skills/review-work/SKILL.md in doctor mode.\n"
    f"{mode}\n"
    "Follow docs/agentic-software-delivery-v1.0/DOCTOR-PROMPT.md:\n\n"
    f"{procedure}"
)
try:
    result = subprocess.run(
        [
            "codex",
            "exec",
            "--cd",
            str(root),
            "--disable",
            "memories",
            "--disable",
            "multi_agent",
            "--sandbox",
            "read-only" if args.check else "workspace-write",
            "-",
        ],
        cwd=root,
        input=request,
        text=True,
        encoding="utf-8",
        check=False,
    )
except FileNotFoundError:
    print("Cannot start doctor: codex executable not found on PATH.", file=sys.stderr)
    sys.exit(127)
sys.exit(result.returncode)
